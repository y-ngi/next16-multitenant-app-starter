# データベース接続 URL（DevContainer / ローカル PostgreSQL 用のダミー値）
DATABASE_URL="postgres://postgres:postgres@localhost:5432/my_app_db"

# アプリケーション基本設定
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth 設定
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
# BETTER_AUTH_URL: 認証サービスの canonical base URL。プロキシは信頼境界外の Host/X-Forwarded-Host ヘッダーによる上書きを制限すること。
BETTER_AUTH_URL="http://localhost:3000"

# Mailpit SMTP 設定 (Dockerコンテナ接続時は mailpit / ローカル直接接続時は localhost)
SMTP_HOST="mailpit"
SMTP_PORT=1025